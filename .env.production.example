# ============================================================================
#  قالب بيئة الإنتاج — منصّة «أثيل مكة» (atheel-makkah.com) على خادم Contabo
#  انسخ هذا الملف إلى .env على الخادم ثمّ املأ القيم المُعلَّمة بـ«‹...›».
#  لا ترفع .env إلى git إطلاقاً (مُستثنى مسبقاً).
# ============================================================================

APP_NAME="أثيل مكة"
APP_ENV=production
# ⚠️ APP_KEY:
#   - نشرٌ جديد بلا بيانات سابقة:   نفّذ `php artisan key:generate` مرّة واحدة (يملأ هذا السطر).
#   - ترحيل قاعدة بيانات قائمة:      انسخ APP_KEY نفسه من الخادم القديم حرفيّاً (وإلّا تتلف البيانات المشفَّرة والجلسات).
APP_KEY=
APP_DEBUG=false
APP_URL=https://atheel-makkah.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# سجلّات الإنتاج: أخطاء فقط (لا debug)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# ---- قاعدة البيانات (MySQL على الخادم) — املأ من لوحة Contabo/إعداد MySQL ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=‹اسم_قاعدة_البيانات›
DB_USERNAME=‹مستخدم_قاعدة_البيانات›
DB_PASSWORD=‹كلمة_مرور_قاعدة_البيانات›

# ---- الجلسات (مشفّرة، آمنة على HTTPS، مقيَّدة بالنطاق) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.atheel-makkah.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- الطابور: يتطلّب عامل queue:work يعمل دائماً (انظر runbook). ----
# بديل أبسط للإطلاق: غيّرها إلى sync (يُرسَل البريد فوراً بلا عامل) — أبطأ قليلاً لكن بلا خدمة إضافيّة.
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---- البريد (SMTP) — ⚠️ صحّح كلمة المرور (كانت مطابقة لكلمة قاعدة البيانات خطأً) ----
# استخدم بيانات صندوق info@atheel-makkah.com من مزوّد البريد (Hostinger/غيره).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=‹smtp.hostinger.com_أو_خادم_بريدك›
MAIL_PORT=465
MAIL_USERNAME=info@atheel-makkah.com
MAIL_PASSWORD=‹كلمة_مرور_البريد_الصحيحة›
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@atheel-makkah.com
MAIL_FROM_NAME="أثيل مكة"

# ---- تخزين النسخ الاحتياطيّ خارج الخادم (اختياريّ لكن موصى به بشدّة) ----
# إن استخدمت S3 لوجهة النسخ الاحتياطي off-site، املأ التالي؛ وإلّا اترك النسخ محلّيّة + فعّل Contabo Auto Backup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# بريد استقبال تنبيهات النسخ الاحتياطي (نجاح/فشل)
BACKUP_NOTIFICATION_EMAIL=info@atheel-makkah.com

VITE_APP_NAME="${APP_NAME}"
